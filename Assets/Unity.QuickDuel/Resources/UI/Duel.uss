/* QuickDuel's UI Toolkit styling (UQD-T31). Colors are set from code (DuelView's palette, and the label
   sizes vary per call site; the Strike-phase inversion is a filter on the arena backdrop), so this file only
   owns the structural roles that never change at runtime. Every label is bold, matching the original's
   one-font, always-bold look; DuelView sets the shared font (an asset, Resources/UI/Fonts/Cinzel.ttf) on
   the root so every label here inherits it. */

.duel-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-style: bold;
    /* visible, not hidden: Root's own real size tracks the device aspect (see .stage below), so at an
       aspect narrower than 16:9 the fixed-size stage can be very slightly wider than Root itself; letting
       it overflow keeps every centred element on screen instead of clipping its edges. */
    overflow: visible;
}

/* A fixed 1920x1080 frame, always centred in Root regardless of Root's own real (aspect-dependent) size --
   DuelView parents every centre-anchored element (the fighters, every CreateLabel) here instead of
   straight onto Root, so "x pixels from centre" means the same thing at any screen aspect. */
.stage {
    position: absolute;
    width: 1920px;
    height: 1080px;
    left: 50%;
    top: 50%;
    margin-left: -960px;
    margin-top: -540px;
}

/* The arena art (UQD-T33), filling the screen; DuelView sets its image, its cover sizing and, on the cue,
   its invert filter. */
.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-repeat: no-repeat;
}

.letterbox {
    position: absolute;
    left: 0;
    right: 0;
    background-color: rgb(0, 0, 0);
}

.label {
    position: absolute;
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: visible;
}

.label--edge-left {
    -unity-text-align: middle-left;
}

.label--edge-right {
    -unity-text-align: middle-right;
}
