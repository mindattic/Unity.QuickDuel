/* QuickDuel's UI Toolkit styling (UQD-T31). Colors are set from code (DuelView's palette; the Strike-phase
   inversion is a filter on the arena backdrop), so this file only owns the structural roles that never change
   at runtime. Every label is the original's outlined text (OutlinedText, UQD-T36) in one of its five bitmap
   fonts at its native size; the root carries the basic face for anything else. Nothing is bold: a bitmap
   font has no bold weight, and a synthesized one would respace the original's glyphs. */

/* Root is the original's 640 x 480 room as a 1440 x 1080 frame letterboxed into the window (UQD-T50): OriginalFrame
   sets its size, centring and clipping inline, so this rule only carries the type. */
.duel-root {
    -unity-font-style: normal;
}

/* The room's 1440 x 1080 coordinate space, centred in Root (which is the same size) -- DuelView parents every
   centre-anchored element (the fighters, every CreateLabel) here instead of straight onto Root, so "x pixels from
   centre" is measured in the room's own pixels at 2.25 a pixel. */
.stage {
    position: absolute;
    width: 1440px;
    height: 1080px;
    left: 50%;
    top: 50%;
    margin-left: -720px;
    margin-top: -540px;
}

/* The arena art (UQD-T33), filling the room; DuelView sets its image, its cover sizing and, on the cue,
   its invert filter. */
.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-repeat: no-repeat;
}

.letterbox {
    position: absolute;
    left: 0;
    right: 0;
    background-color: rgb(0, 0, 0);
}

.label {
    position: absolute;
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: visible;
}

.label--edge-left {
    -unity-text-align: middle-left;
}

.label--edge-right {
    -unity-text-align: middle-right;
}

